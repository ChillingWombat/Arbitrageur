# Arbitrager headless environment — SAMPLE ONLY. Copy to
# /etc/arbitrager/arbitrager.env and adjust. No secrets belong here:
# API credentials live in the encrypted vault (~/.arbitrager/vault.enc),
# which is created/unlocked from the desktop UI only. Never paste private
# keys, API secrets, or passphrases into this file.

# Loopback bind for the headless health listener. Override per instance in
# /etc/arbitrager/<port>.env when binding is managed per port.
ARBITRAGER_BIND=127.0.0.1

# Rust log filter for the daemon (journald captures stdout/stderr).
RUST_LOG=info

# Absolute path of the headless CLI binary installed from this repo.
# Built with: cargo build --release --bin arbitrager
ARBITRAGER_BIN=/usr/local/bin/arbitrager
