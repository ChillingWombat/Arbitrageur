# Arbitrageur headless environment — LEGACY SAMPLE NAME.
# New installs should copy arbitrageur.env.sample to
# /etc/arbitrageur/arbitrageur.env instead.
#
# No secrets belong here: API credentials live in the encrypted vault
# (~/.arbitrageur/vault.enc), which is created/unlocked from the desktop UI
# only. Never paste private keys, API secrets, or passphrases into this file.

# Loopback bind for the headless health listener. The unit also reads the
# optional per-instance file /etc/arbitrageur/arbitrageur-<port>.env after
# this common file, so a per-port bind can override the shared default.
ARBITRAGEUR_BIND=127.0.0.1

# Rust log filter for the daemon (journald captures stdout/stderr).
RUST_LOG=info
