[Unit]
Description=Arbitrageur headless paper daemon (legacy template name; port %i)
Documentation=file:///opt/arbitrageur/ops/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Legacy filename kept for compatibility. New installs should copy
# arbitrageur@.service and enable arbitrageur@<port>.service instead.
Environment=ARBITRAGEUR_BIND=127.0.0.1
EnvironmentFile=-/etc/arbitrageur/arbitrageur.env
EnvironmentFile=-/etc/arbitrageur/arbitrageur-%i.env
ExecStart=/usr/local/bin/arbitrageur serve --port %i
Environment=HOME=/var/lib/arbitrageur-%i
StateDirectory=arbitrageur-%i
StateDirectoryMode=0700
User=arbitrageur
Group=arbitrageur
UMask=0077
WorkingDirectory=/var/lib/arbitrageur-%i
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arbitrageur-%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
