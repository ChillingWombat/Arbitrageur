# Arbitrageur headless environment — SAMPLE ONLY. Copy to
# /etc/arbitrageur/arbitrageur.env and adjust. No secrets belong here:
# API credentials live in the encrypted vault (~/.arbitrageur/vault.enc),
# which is created/unlocked from the desktop UI only. Never paste private
# keys, API secrets, or passphrases into this file.

# Loopback bind for the headless health listener. The unit also reads the
# optional per-instance file /etc/arbitrageur/arbitrageur-<port>.env after
# this common file, so a per-port bind can override the shared default.
ARBITRAGEUR_BIND=127.0.0.1

# Rust log filter for the daemon (journald captures stdout/stderr).
# Honored via EnvFilter — e.g. "info", "debug", "arbitrageur=trace,info".
RUST_LOG=info

# Out-of-band operator alerts. When set to an http(s) URL, the engine
# POSTs a small JSON body on circuit-breaker trips and signals escalating
# to `unresolved` — events that otherwise stay UI/journal-only until a
# human opens the app. Compatible with generic webhook receivers
# (Slack/Discord incoming webhooks, ntfy.sh, Alertmanager). The same var
# is also used by /etc/arbitrageur/alert.sh for service-failure pages
# (see arbitrageur-notify@.service).
# ARBITRAGEUR_ALERT_WEBHOOK=https://ntfy.sh/your-private-topic
