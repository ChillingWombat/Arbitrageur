# Rust build artifacts
target/
# Windows-native builds keep their own target dir so the Linux container's
# artifacts are never mixed with MSVC ones.
target-win/

# Pixi environment
.pixi/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/

# Environment variables & secrets
.env
*.env
*.key
*.pem
keychain.toml

# IDE
.idea/
.vscode/
*.swp
*.swo

# Frontend artifacts
frontend/node_modules/
frontend/dist/
frontend/src-tauri/target/

# Local sysroot dependencies
.sysroot/

# Logs & data
logs/
*.log
data/cache/
data/captures/
.playwright-mcp/
.omo/

# Vault & durable state — a repo-local HOME must never commit the
# credential vault or the trading-history sqlite store.
vault.enc
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
*.hold

# Local desktop launcher shortcuts
Arbitrageur
*.desktop
node_modules/

# Stray build artifacts (rustc test rlibs copied into the repo root)
*.rlib

# Local-only working material: review notes and agent state. Never publish
# these — they quote operational details (sockets, hostnames, credentials).
.review/
.workbuddy/
/.agents/

# Agent/session artifacts and one-off handoff reports. Keep product docs and
# runbooks tracked; keep working notes local.
/ORIGINAL_REQUEST.md
/PROJECT.md
/TEST_INFRA.md
/TEST_READY.md
/docs/HANDOFF_*.md
/docs/DIAGNOSIS_*.md
/docs/SYSTEM_AUDIT_*.md
/docs/archive/
/scripts/resume_subagents.py

# Mock-only E2E harness and its wrapper. Real Rust and frontend suites stay.
/tests/e2e/
/scripts/run_e2e_tests.sh

# TypeScript incremental build metadata
frontend/*.tsbuildinfo
